# Frontend público (admin/assets/config.js usa somente URL e anon key)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=

# Somente Edge Functions / servidor. NUNCA enviar para o navegador ou Git.
SUPABASE_SERVICE_ROLE_KEY=
INTEGRATION_WORKER_SECRET=
PUBLIC_APP_ORIGIN=https://seudominio.com.br

# Geração de banners por IA (função gerar-banner)
# BANNER_AI_PROVIDER: "stability" (padrão) ou "openai"
BANNER_AI_PROVIDER=stability
STABILITY_API_KEY=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Frete e entregas — função cotar-frete (veja docs/FRETE-ENTREGAS.md)
# Sem estas chaves a loja cota pela tabela padrão (estimativa por zona de CEP).
ORIGEM_CEP=26275280

# Correios (API REST com contrato — comece apontando ao homolog)
CORREIOS_API_BASE=https://apihom.correios.com.br
CORREIOS_USUARIO=
CORREIOS_SENHA=
CORREIOS_CARTAO_POSTAGEM=
CORREIOS_PRODUTO_PAC=04510
CORREIOS_PRODUTO_SEDEX=04014

# Mercado Envios (token de vendedor do Mercado Livre)
MERCADO_ENVIOS_TOKEN=

# Uber Direct (entrega no mesmo dia — Rio e Baixada)
UBER_DIRECT_CUSTOMER_ID=
UBER_DIRECT_CLIENT_ID=
UBER_DIRECT_CLIENT_SECRET=
UBER_DIRECT_PICKUP={"street_address":["Rua da Matriz, 100"],"city":"Nova Iguaçu","state":"RJ","zip_code":"26275280","country":"BR"}

# 99 Entregas (adaptador do parceiro empresarial)
ENTREGAS99_QUOTE_URL=
ENTREGAS99_TOKEN=

# e.Rede — iniciar sempre em sandbox
REDE_ENV=sandbox
REDE_CLIENT_ID=
REDE_CLIENT_SECRET=

# ClearSale — iniciar sempre em sandbox
CLEARSALE_ENV=sandbox
CLEARSALE_API_KEY=
CLEARSALE_CLIENT_ID=
CLEARSALE_CLIENT_SECRET=
CLEARSALE_WEBHOOK_API_KEY=

# Alterdata Moda/Muven — preencher conforme manual da versão contratada
ALTERDATA_BASE_URL=
ALTERDATA_AUTH_TYPE=Bearer
ALTERDATA_TOKEN=
ALTERDATA_CATALOG_PATH=
ALTERDATA_INVENTORY_PATH=
ALTERDATA_INVENTORY_UPDATE_PATH=
ALTERDATA_ORDERS_PATH=
