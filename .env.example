# Frontend público (admin/assets/config.js usa somente URL e anon key)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=

# Somente Edge Functions / servidor. NUNCA enviar para o navegador ou Git.
SUPABASE_SERVICE_ROLE_KEY=
INTEGRATION_WORKER_SECRET=
PUBLIC_APP_ORIGIN=https://seudominio.com.br

# Geração de banners por IA (função gerar-banner)
# BANNER_AI_PROVIDER: "stability" (padrão) ou "openai"
BANNER_AI_PROVIDER=stability
STABILITY_API_KEY=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Frete e entregas — função cotar-frete (veja docs/FRETE-ENTREGAS.md)
# Sem estas chaves a loja cota pela tabela padrão (estimativa por zona de CEP).
ORIGEM_CEP=26275280

# Correios (API REST com contrato — comece apontando ao homolog)
CORREIOS_API_BASE=https://apihom.correios.com.br
CORREIOS_USUARIO=
CORREIOS_SENHA=
CORREIOS_CARTAO_POSTAGEM=
CORREIOS_PRODUTO_PAC=04510
CORREIOS_PRODUTO_SEDEX=04014

# Mercado Envios (token de vendedor do Mercado Livre)
MERCADO_ENVIOS_TOKEN=

# Uber Direct (entrega no mesmo dia — Rio e Baixada)
UBER_DIRECT_CUSTOMER_ID=
UBER_DIRECT_CLIENT_ID=
UBER_DIRECT_CLIENT_SECRET=
UBER_DIRECT_PICKUP={"street_address":["Rua da Matriz, 100"],"city":"Nova Iguaçu","state":"RJ","zip_code":"26275280","country":"BR"}

# 99 Entregas (adaptador do parceiro empresarial)
ENTREGAS99_QUOTE_URL=
ENTREGAS99_TOKEN=

# e.Rede — iniciar sempre em sandbox
REDE_ENV=sandbox
REDE_CLIENT_ID=
REDE_CLIENT_SECRET=

# ClearSale — iniciar sempre em sandbox
CLEARSALE_ENV=sandbox
CLEARSALE_API_KEY=
CLEARSALE_CLIENT_ID=
CLEARSALE_CLIENT_SECRET=
CLEARSALE_WEBHOOK_API_KEY=

# Alterdata Moda/Muven — preencher conforme manual da versão contratada
ALTERDATA_BASE_URL=
ALTERDATA_AUTH_TYPE=Bearer
ALTERDATA_TOKEN=
ALTERDATA_CATALOG_PATH=
ALTERDATA_INVENTORY_PATH=
ALTERDATA_INVENTORY_UPDATE_PATH=
ALTERDATA_ORDERS_PATH=

# =====================================================================
# Audiência do site e canais de venda (admin/ → Audiência · Canais)
# =====================================================================

# URL pública do site: monta os links dos feeds e o event_source_url da Meta
PUBLIC_SITE_URL=https://seudominio.com.br

# Google Merchant Center — feed de produtos (função google-merchant-feed)
GOOGLE_MERCHANT_ID=
GOOGLE_MERCHANT_SERVICE_ACCOUNT_JSON=
# Token da URL de coleta primária (o Google busca o feed com ?token=…)
GOOGLE_MERCHANT_FEED_TOKEN=
GOOGLE_MERCHANT_COUNTRY=BR
GOOGLE_MERCHANT_FEED_LABEL=BR

# Meta Ads — Conversions API e catálogo (função marketing-events)
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_CATALOG_ID=
META_AD_ACCOUNT_ID=
META_GRAPH_VERSION=v19.0
# Preencha enquanto testa: os eventos aparecem no Test Events do Meta
META_TEST_EVENT_CODE=

# GA4 — Measurement Protocol (função marketing-events)
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# Mercado Livre — API oficial (OAuth2 com refresh token)
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_REFRESH_TOKEN=

# Shopee — Open Platform v2 (assinatura HMAC-SHA256)
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=
# Homologação: https://open-api.sandbox.shopee.com.br
SHOPEE_BASE_URL=https://partner.shopeemobile.com

# Amazon — Selling Partner API (LWA + assinatura AWS SigV4)
AMAZON_SP_API_REFRESH_TOKEN=
AMAZON_SP_API_CLIENT_ID=
AMAZON_SP_API_CLIENT_SECRET=
AMAZON_SP_API_AWS_ACCESS_KEY=
AMAZON_SP_API_AWS_SECRET_KEY=
AMAZON_SP_API_REGION=us-east-1
AMAZON_SP_API_ENDPOINT=https://sellingpartnerapi-na.amazon.com
AMAZON_MARKETPLACE_ID=
AMAZON_SP_API_SELLER_ID=

# Magazine Luiza — API do Parceiro (URL de homologação ou produção)
MAGALU_API_TOKEN=
MAGALU_API_BASE_URL=

# Americanas Marketplace — API B2W (client credentials)
AMERICANAS_CLIENT_ID=
AMERICANAS_CLIENT_SECRET=
AMERICANAS_API_KEY=
AMERICANAS_API_BASE_URL=https://api-parceiros.americanas.io
